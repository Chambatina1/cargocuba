// =============================================
// CargoCuba - Recogidas con Ruta Optimizada
// VERDE = esperando | MORADO = recogido
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// PICKUP REQUEST (Recogida)
// =============================================

model PickupRequest {
  id            Int      @id @default(autoincrement())
  nombre        String
  telefono      String?
  direccion     String
  lat           Float
  lng           Float
  notas         String?
  estado        String   @default("esperando")  // esperando, recogido, cancelado
  choferAsignado String?
  ordenRuta     Int?
  fechaRecogida DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([estado])
  @@index([choferAsignado])
  @@index([fechaRecogida])
  @@index([createdAt])
}
