// =============================================
// Flota de Autos - Simplified Schema
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// PROVIDER (Conductor)
// =============================================

model Provider {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  pin           String

  // Car info
  carBrand      String?
  carModel      String?

  // Ubicación GPS
  lat           Float    @default(23.1136)
  lng           Float    @default(-82.3666)

  // Estado
  active        Boolean  @default(true)
  available     Boolean  @default(false)  // "Live" - debe activarse manualmente
  rating        Float    @default(5.0)
  totalJobs     Int      @default(0)

  // Perfil / Ficha de presentación
  photo         String?  // Foto de perfil (URL o base64)
  bio           String?  // Descripción del servicio que ofrece
  businessName  String?  // Nombre del negocio
  services      String?  // Lista de servicios ofrecidos (JSON string)
  priceRange    String?  // Rango de precios
  schedule      String?  // Horario de trabajo
  socialMedia   String?  // Redes sociales (JSON string)

  // Fotos del vehículo (base64 comprimido)
  carPhoto1     String?
  carPhoto2     String?
  carPhoto3     String?

  // Notas adicionales
  notes         String?

  // Identificación (opcional para registro rápido)
  idNumber      String?

  // Suspensión por administrador
  suspended       Boolean   @default(false)
  suspendedReason String?
  suspendedAt     DateTime?

  // Referido por alguien
  referredByName    String?
  referredByPhone   String?

  // Sesión
  sessionToken  String?
  sessionExpiry DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([active])
  @@index([available])
}
