// =============================================
// CargoCuba - Recogidas con Ruta Optimizada
// VERDE = esperando | MORADO = recogido
// Chofer se ve moviendo en tiempo real en el mapa
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// PICKUP REQUEST (Recogida)
// =============================================

model PickupRequest {
  id            Int      @id @default(autoincrement())
  nombre        String
  telefono      String?
  direccion     String
  lat           Float
  lng           Float
  notas         String?
  horarioReady  String?                          // "HH:MM" - hora que el cliente esta listo
  estado        String   @default("esperando")  // esperando, recogido, cancelado
  origen        String   @default("cliente")    // cliente, oficina
  choferAsignado String?
  ordenRuta     Int?
  fechaRecogida DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([estado])
  @@index([choferAsignado])
  @@index([fechaRecogida])
  @@index([createdAt])
}

// =============================================
// DRIVER LOCATION (GPS en tiempo real del chofer)
// =============================================

model DriverLocation {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  nombre    String
  lat       Float
  lng       Float
  activo    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([activo])
}
