# =============================================
# CargoCuba - Variables de entorno
# =============================================
# Copia este archivo a .env y completa los valores.
# NUNCA commits el .env real. Este proyecto es INDEPENDIENTE de
# plataformachambatina: usa su propia base de datos y sus propias claves.
# =============================================

# Base de datos (PostgreSQL en Render, SQLite en dev)
DATABASE_URL=postgresql://usuario:password@host:5432/cargocuba
# Dev local: file:./prisma/db/dev.db

# ─── Autenticacion admin (NextAuth) ───
# Clave de admin principal (>= 4 caracteres). Requerida para acceder a /admin
# y para escrituras en /api/pickups y /api/routing.
ADMIN_PASSWORD=cambia-esta-clave
# PIN corto alternativo (opcional, >= 4 digitos)
# ADMIN_PIN=1234

# Secreto para firmar el JWT de sesion. Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL publica del deploy (sin slash final)
NEXTAUTH_URL=https://cargocuba.onrender.com

# ─── Mini-servicios (optimizador VRP + tracking) ───
# Puerto del mini-servicio vrp-solver (asignado por el runtime de mini-services).
# Si se omite, la app llama a localhost:3010 (dev) o usa el fallback TS en proceso.
VRP_SOLVER_PORT=3010
# URL completa (opcional, tiene prioridad sobre VRP_SOLVER_PORT)
# VRP_SOLVER_URL=http://localhost:3010

# Puerto del mini-servicio tracking-server (Socket.IO)
TRACKING_PORT=3011

# ─── Cliente (expuestas al navegador, prefijo NEXT_PUBLIC_) ───
# URL del tracking-server para el navegador. En dev: http://localhost:3011
# En produccion detras de Caddy: misma origin con ?XTransformPort=3011 (auto)
# NEXT_PUBLIC_TRACKING_URL=
# NEXT_PUBLIC_TRACKING_PORT=3011
